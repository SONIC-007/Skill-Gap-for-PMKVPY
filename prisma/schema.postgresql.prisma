// PostgreSQL Schema for PMKVY Skill Gap Analyser
// To switch to PostgreSQL:
// 1. Rename this file to schema.prisma (or update datasource in schema.prisma)
// 2. Set DATABASE_URL="postgresql://user:password@localhost:5432/pmkvy_skill_gap?schema=public" in .env
// 3. Run: npx prisma db push (or npx prisma migrate dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  password       String
  role           String           @default("CANDIDATE")
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        CandidateProfile?
  assessments    Assessment[]
  enrollments    CourseEnrollment[]
  candidateSkills CandidateSkill[]

  @@index([email])
}

model CandidateProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  education         String?
  experience        String?
  location          String?
  desiredCareerField String?
  targetJobRole     String?
  bio               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id              String        @id @default(cuid())
  name            String        @unique
  category        String        @default("TECHNICAL")
  domain          String
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  jobRequirements  JobSkillRequirement[]
  candidateSkills  CandidateSkill[]
  courseSkills      CourseSkill[]
  assessmentQuestions AssessmentQuestion[]

  @@index([domain])
  @@index([category])
}

model JobRole {
  id          String   @id @default(cuid())
  title       String   @unique
  domain      String
  description String?
  minExperience String?
  avgSalary   String?
  demandLevel String?  @default("Medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skillRequirements JobSkillRequirement[]
  assessments       Assessment[]
  courses           TrainingCourse[]

  @@index([domain])
}

model JobSkillRequirement {
  id                 String  @id @default(cuid())
  jobRoleId          String
  skillId            String
  requiredProficiency Int    @default(70)
  importance         String  @default("Required")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  jobRole JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, skillId])
}

model CandidateSkill {
  id             String   @id @default(cuid())
  userId         String
  skillId        String
  proficiency    Int      @default(0)
  verified       Boolean  @default(false)
  lastAssessedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model Assessment {
  id          String   @id @default(cuid())
  userId      String
  jobRoleId   String
  score       Float?
  skillGap    Float?
  status      String   @default("IN_PROGRESS")
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRole   JobRole            @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([userId])
  @@index([jobRoleId])
}

model AssessmentQuestion {
  id         String        @id @default(cuid())
  skillId    String
  question   String
  type       String        @default("RATING")
  options    String?
  correctAnswer String?
  difficulty String        @default("INTERMEDIATE")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  skill     Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([skillId])
}

model AssessmentResponse {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  answer       String
  score        Float?
  createdAt    DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model TrainingCourse {
  id            String          @id @default(cuid())
  name          String
  description   String?
  provider      String?
  difficulty    String          @default("BEGINNER")
  duration      String?
  eligibility   String?
  category      String?
  imageUrl      String?
  isDemo        Boolean         @default(true)
  jobRoleId     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  jobRole     JobRole?          @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  courseSkills CourseSkill[]
  enrollments CourseEnrollment[]

  @@index([category])
  @@index([difficulty])
}

model CourseSkill {
  id       String @id @default(cuid())
  courseId  String
  skillId  String

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId     String
  status      String   @default("ENROLLED")
  progress    Int      @default(0)
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LearningProgress {
  id          String   @id @default(cuid())
  userId      String
  skillName   String
  proficiency Int      @default(0)
  date        DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}
