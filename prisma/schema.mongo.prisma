generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String             @unique
  password        String
  role            String             @default("CANDIDATE") // CANDIDATE, ADMIN
  image           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  profile         CandidateProfile?
  assessments     Assessment[]
  enrollments     CourseEnrollment[]
  candidateSkills CandidateSkill[]
}

model CandidateProfile {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  education          String?
  experience         String?
  location           String?
  desiredCareerField String?
  targetJobRole      String?
  bio                String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  category    String   @default("TECHNICAL") // TECHNICAL, SOFT
  domain      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRequirements     JobSkillRequirement[]
  candidateSkills     CandidateSkill[]
  courseSkills        CourseSkill[]
  assessmentQuestions AssessmentQuestion[]

  @@index([domain])
  @@index([category])
}

model JobRole {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String   @unique
  domain        String
  description   String?
  minExperience String?
  avgSalary     String?
  demandLevel   String?  @default("Medium")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skillRequirements JobSkillRequirement[]
  assessments       Assessment[]
  courses           TrainingCourse[]

  @@index([domain])
}

model JobSkillRequirement {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  jobRoleId           String   @db.ObjectId
  skillId             String   @db.ObjectId
  requiredProficiency Int      @default(70) // 0-100
  importance          String   @default("Required") // Required, Preferred, Nice-to-have
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jobRole JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, skillId])
}

model CandidateSkill {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  skillId        String    @db.ObjectId
  proficiency    Int       @default(0) // 0-100
  verified       Boolean   @default(false)
  lastAssessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model Assessment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  jobRoleId   String    @db.ObjectId
  score       Float?
  skillGap    Float?
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRole   JobRole              @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([userId])
  @@index([jobRoleId])
}

model AssessmentQuestion {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  skillId       String   @db.ObjectId
  question      String
  type          String   @default("RATING") // RATING, MCQ, TRUE_FALSE
  options       String? // JSON string for MCQ options
  correctAnswer String?
  difficulty    String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skill     Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([skillId])
}

model AssessmentResponse {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  assessmentId String   @db.ObjectId
  questionId   String   @db.ObjectId
  answer       String
  score        Float?
  createdAt    DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model TrainingCourse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  provider    String?
  difficulty  String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  duration    String?
  eligibility String?
  category    String?
  imageUrl    String?
  isDemo      Boolean  @default(true) // Marks as sample data
  jobRoleId   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRole      JobRole?           @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  courseSkills CourseSkill[]
  enrollments  CourseEnrollment[]

  @@index([category])
  @@index([difficulty])
}

model CourseSkill {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  courseId String @db.ObjectId
  skillId  String @db.ObjectId

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
}

model CourseEnrollment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  courseId    String    @db.ObjectId
  status      String    @default("ENROLLED") // ENROLLED, IN_PROGRESS, COMPLETED
  progress    Int       @default(0) // 0-100
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LearningProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  skillName   String
  proficiency Int      @default(0)
  date        DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}
